{
  "name": "@rlsfyi/mcp",
  "version": "0.3.0",
  "description": "MCP server for publishing releases to rls.fyi",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rlsfyi-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mcp",
    "release-notes",
    "changelog",
    "llm",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "ajv": "8.20.0",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.6",
    "hono": "4.13.5",
    "ip-address": "10.5.0",
    "jose": "6.2.10",
    "qs": "6.15.3",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
